{
  "name": "ball-escape-studio",
  "version": "0.1.0",
  "description": "A browser studio for making satisfying ball-physics shorts (ring escapes and friends), with deterministic simulation and frame-perfect MP4 export.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/sim.ts",
    "test": "tsx scripts/determinism.ts",
    "schema": "tsx scripts/schema.ts",
    "eval:ai": "tsx scripts/ai-eval.ts",
    "tournament": "tsx scripts/tournament.ts",
    "songs": "tsx scripts/songbook.ts",
    "fuzz": "tsx scripts/fuzz.ts",
    "tiktok": "tsx scripts/tiktok.ts"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "zod-to-json-schema": "^3.25.2"
  }
}
